        "responses": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "inline"
                  },
                  "response": {
                    "$ref": "#/$defs/Response"
                  }
                },
                "required": [
                  "kind",
                  "response"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "shared"
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "security": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scheme": {
                  "type": "string"
                },
                "scopes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "scheme",
                "scopes"
              ],
              "additionalProperties": false
            }
          }
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "key",
        "method",
        "path",
        "version",
        "operationId",
        "tags",
        "deprecated",
        "parameters",
        "responses",
        "security",
        "extensions"
      ],
      "additionalProperties": false,
      "description": "One route in one version. `key` is built from the normalized path, for example `GET /users/{} @2024-01-01`."
    },
    "Parameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "in": {
          "type": "string",
          "enum": [
            "path",
            "query",
            "header"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        },
        "encoding": {
          "type": "string",
          "enum": [
            "plain",
            "json"
          ]
        }
      },
      "required": [
        "name",
        "in",
        "required",
        "shape",
        "encoding"
      ],
      "additionalProperties": false,
      "description": "A path, query or header parameter. `encoding: json` means the value travels as a JSON string."
    }
