            "docs": {
              "$ref": "#/$defs/Docs"
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "additionalProperties": false
        }
      ],
      "description": "A JSON wire value. `null` is a union member; a literal is a one-member enum; `ref.target` names a key of `types`."
    },
    "Docs": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "examples": {
          "type": "array",
          "items": {}
