                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "default": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "enum": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "default"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "requestBody": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "content": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "$ref": "#/$defs/MediaType"
              }
            }
          },
          "required": [
            "required",
            "content"
          ],
          "additionalProperties": false
