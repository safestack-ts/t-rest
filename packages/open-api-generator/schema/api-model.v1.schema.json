{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApiModelDocument",
  "description": "The API model of one spec: its operations and the types, shared responses and security schemes they reach.",
  "type": "object",
  "properties": {
    "modelVersion": {
      "type": "number",
      "const": 1
    },
    "versioning": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "date",
                "semver"
              ]
            },
            "history": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "history"
          ],
          "additionalProperties": false
        }
      ]
    },
    "types": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/TypeDef"
      }
    },
    "responses": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Response"
      }
    },
    "securitySchemes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/SecurityScheme"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Operation"
      }
    }
  },
  "required": [
    "modelVersion",
    "versioning",
    "types",
    "responses",
    "securitySchemes",
    "operations"
  ],
  "additionalProperties": false,
  "$defs": {
    "TypeDef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "named"
            },
            "id": {
              "type": "string"
            },
            "direction": {
              "type": "string",
              "enum": [
                "input",
                "output"
              ]
            },
            "shape": {
              "$ref": "#/$defs/Shape"
            }
          },
          "required": [
            "kind",
            "id",
            "direction",
            "shape"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "anonymous"
            },
            "direction": {
              "type": "string",
              "enum": [
                "input",
                "output"
              ]
            },
            "shape": {
              "$ref": "#/$defs/Shape"
            }
          },
          "required": [
            "kind",
            "direction",
            "shape"
          ],
          "additionalProperties": false
        }
      ],
      "description": "A type other shapes refer to. `anonymous` is recursion without an author id."
    },
    "Shape": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unknown"
            },
            "docs": {
              "$ref": "#/$defs/Docs"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "never"
            },
            "docs": {
              "$ref": "#/$defs/Docs"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "null"
            },
            "docs": {
              "$ref": "#/$defs/Docs"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "boolean"
            },
            "docs": {
              "$ref": "#/$defs/Docs"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string"
            },
            "format": {
              "type": "string"
            },
            "pattern": {
              "type": "string"
            },
            "minLength": {
              "type": "number"
            },
            "maxLength": {
              "type": "number"
            },
            "contentEncoding": {
              "type": "string"
            },
            "contentMediaType": {
              "type": "string"
            },
            "docs": {
              "$ref": "#/$defs/Docs"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "number"
            },
            "integer": {
              "type": "boolean"
            },
            "format": {
              "type": "string"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "exclusiveMinimum": {
              "type": "number"
            },
            "exclusiveMaximum": {
              "type": "number"
            },
            "multipleOf": {
              "type": "number"
            },
            "docs": {
              "$ref": "#/$defs/Docs"
            }
          },
          "required": [
            "kind",
            "integer"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "enum"
            },
            "values": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "docs": {
              "$ref": "#/$defs/Docs"
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "array"
            },
            "items": {
              "$ref": "#/$defs/Shape"
            },
            "minItems": {
              "type": "number"
            },
            "maxItems": {
              "type": "number"
            },
            "uniqueItems": {
              "type": "boolean"
            },
            "docs": {
              "$ref": "#/$defs/Docs"
            }
          },
          "required": [
            "kind",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tuple"
            },
            "prefix": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Shape"
              }
            },
            "rest": {
              "$ref": "#/$defs/Shape"
            },
            "minItems": {
              "type": "number"
            },
            "docs": {
              "$ref": "#/$defs/Docs"
            }
          },
          "required": [
            "kind",
            "prefix"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "object"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Field"
              }
            },
            "additional": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Shape"
                },
                {
                  "type": "boolean",
                  "const": false
                }
              ]
            },
            "propertyNames": {
              "$ref": "#/$defs/Shape"
            },
            "minProperties": {
              "type": "number"
            },
            "maxProperties": {
              "type": "number"
            },
            "docs": {
              "$ref": "#/$defs/Docs"
            }
          },
          "required": [
            "kind",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "union"
            },
            "members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Shape"
              }
            },
            "exclusive": {
              "type": "boolean"
            },
            "docs": {
              "$ref": "#/$defs/Docs"
            }
          },
          "required": [
            "kind",
            "members",
            "exclusive"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "intersection"
            },
            "members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Shape"
              }
            },
            "docs": {
              "$ref": "#/$defs/Docs"
            }
          },
          "required": [
            "kind",
            "members"
          ],
          "additionalProperties": false
