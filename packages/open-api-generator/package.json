{
  "name": "@t-rest/open-api-generator",
  "version": "1.0.0-alpha.61",
  "description": "OpenAPI 3.0, 3.1 and 3.2 documents from a t-rest bag of routes, read from Standard JSON Schema",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./api-model.schema.json": "./schema/api-model.v1.schema.json"
  },
  "typesVersions": {
    "*": {
      "api-model.schema.json": [
        "./schema/api-model.v1.schema.json"
      ]
    }
  },
  "files": [
    "dist/**/*",
    "schema/**/*"
  ],
  "scripts": {
    "build": "tsup",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "test:unit": "TZ=UTC vitest unit",
    "test:integration": "TZ=UTC vitest integration"
  },
  "keywords": [],
  "author": "Yannick Stachelscheid",
  "license": "MIT",
  "dependencies": {
    "@t-rest/core": "workspace:^",
    "@t-rest/protocol": "workspace:^",
    "http-status-codes": "^2.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "zod": "^4.5.0"
  },
  "peerDependencies": {
    "zod": "^4.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
