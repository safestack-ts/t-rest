{
    "name": "@t-rest/oxlint-plugin",
    "version": "0.0.0",
    "description": "Oxlint and ESLint rule that requires an id on every exported zod model of a typed-rest API",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": {
                "import": "./dist/index.d.ts",
                "require": "./dist/index.d.cts"
            },
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist/**/*"
    ],
    "scripts": {
        "build": "tsup",
        "test": "TZ=UTC vitest run",
        "test:watch": "TZ=UTC vitest",
        "test:unit": "TZ=UTC vitest unit",
        "test:integration": "TZ=UTC vitest integration"
    },
    "keywords": ["oxlint", "eslint", "zod", "openapi"],
    "author": "Yannick Stachelscheid",
    "license": "MIT",
    "dependencies": {},
    "devDependencies": {},
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22"
    }
}
