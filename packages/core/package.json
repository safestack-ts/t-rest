{
  "name": "@t-rest/core",
  "version": "1.0.0-alpha.26",
  "description": "",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./zod": {
      "types": {
        "import": "./dist/zod.d.ts",
        "require": "./dist/zod.d.cts"
      },
      "import": "./dist/zod.js",
      "require": "./dist/zod.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "zod": [
        "./dist/zod.d.ts"
      ]
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsup",
    "test": "TZ=UTC vitest run"
  },
  "keywords": [],
  "author": "Yannick Stachelscheid",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "dependencies": {
    "@t-rest/protocol": "workspace:^",
    "@standard-schema/spec": "^1.1.0"
  }
}
