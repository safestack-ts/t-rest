{
  "name": "@t-rest/supertest-adapter",
  "version": "1.0.0-alpha.45",
  "description": "",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsup",
    "test": "TZ=UTC ../../node_modules/.bin/jest --config jest.config.cjs --colors --passWithNoTests",
    "test:watch": "TZ=UTC ../../node_modules/.bin/jest --watch --config jest.config.cjs --colors --passWithNoTests",
    "test:unit": "TZ=UTC ../../node_modules/.bin/jest --watch --config jest.config.cjs --colors --passWithNoTests unit",
    "test:integration": "TZ=UTC ../../node_modules/.bin/jest --watch --config jest.config.cjs --colors --passWithNoTests integration"
  },
  "keywords": [],
  "author": "Yannick Stachelscheid",
  "license": "MIT",
  "dependencies": {
    "@t-rest/client-utils": "workspace:*",
    "@t-rest/core": "workspace:*",
    "@t-rest/express-server": "workspace:*",
    "supertest": "^6.3.4"
  },
  "devDependencies": {
    "@t-rest/testing-utilities": "workspace:*",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/helmet": "^4.0.0",
    "@types/supertest": "^6.0.2",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "helmet": "^7.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
