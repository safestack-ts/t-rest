{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Debug OpenAPI Spec Generator",
        "cwd": "${workspaceFolder}/packages/open-api-generator",
        "program": "./dist/cjs/playground.js",
        "env": {
          "NODE_ENV": "development"
        },
        "args": ["-c", "3"],
        "console": "integratedTerminal",
        "skipFiles": ["<node_internals>/**"]
      },
      {
        "type": "node",
        "request": "launch",
        "name": "Debug OpenAPI Spec Generator Demo",
        "cwd": "${workspaceFolder}/packages/open-api-generator",
        "program": "./dist/cjs/demo.js",
        "env": {
          "NODE_ENV": "development"
        },
        "args": ["-c", "3"],
        "console": "integratedTerminal",
        "skipFiles": ["<node_internals>/**"]
      },
      {
        "type": "node",
        "request": "launch",
        "name": "Debug Vitest Express Server Test Case",
        "presentation": {
          "group": "Debug Tests"
        },
        "program": "${workspaceRoot}/node_modules/vitest/vitest.mjs",
          "cwd": "${workspaceFolder}/packages/express-server/",
        "env": { "NODE_ENV": "test", "TZ": "UTC" },
        "args": ["run", "${fileBasename}", "--no-file-parallelism"],
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen",
        "autoAttachChildProcesses": false
      },
      {
        "type": "node",
        "request": "launch",
        "name": "Debug Vitest Client Test Case",
        "presentation": {
          "group": "Debug Tests"
        },
        "program": "${workspaceRoot}/node_modules/vitest/vitest.mjs",
          "cwd": "${workspaceFolder}/packages/client/",
        "env": { "NODE_ENV": "test", "TZ": "UTC" },
        "args": ["run", "${fileBasename}", "--no-file-parallelism"],
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen",
        "autoAttachChildProcesses": false
      },
      {
        "type": "node",
        "request": "launch",
        "name": "Debug Vitest OpenAPI Generator Test Case",
        "presentation": {
          "group": "Debug Tests"
        },
        "program": "${workspaceRoot}/node_modules/vitest/vitest.mjs",
          "cwd": "${workspaceFolder}/packages/open-api-generator/",
        "env": { "NODE_ENV": "test", "TZ": "UTC" },
        "args": ["run", "${fileBasename}", "--no-file-parallelism"],
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen",
        "autoAttachChildProcesses": false
      },
    ]
}
