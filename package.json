{
  "name": "t-rest",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "scripts": {
    "build": "pnpm recursive run build",
    "build:watch": "tsc --build --watch",
    "clean": "rm -rf **/dist && rm -rf **/*.tsbuildinfo",
    "test": "pnpm recursive run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "pnpm -r exec tsc --noEmit -p tsconfig.ref.json",
    "format": "prettier --write \"./**/*.ts\"",
    "changeset:add": "pnpm changeset",
    "changeset:check": "pnpm exec ./scripts/check-changeset-status.sh",
    "changeset:publish": "pnpm changeset publish",
    "changeset:snapshot:publish": "pnpm changeset publish --tag dev --no-git-tag",
    "changeset:snapshot:version": "pnpm changeset version --snapshot dev",
    "pub:dev": "pnpm build && pnpm exec ./scripts/publish-dev-version.sh",
    "prepublish": "pnpm clean && pnpm build",
    "check:packages": "node scripts/check-package-dependencies.mjs && pnpm -r --no-bail --filter \"!@t-rest/playground\" --filter \"!@t-rest/testing-utilities\" exec sh -c \"publint --strict && attw --pack .\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@safestack/prettier-config": "^1.0.1",
    "@types/supertest": "^7.2.1",
    "conditional-type-checks": "^1.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^14.0.3",
    "publint": "^0.3.25",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@changesets/cli": "^2.31.1",
    "http-status-codes": "^2.3.0",
    "zod": "^4.6.7"
  },
  "workspaces": [
    "packages/*"
  ]
}
